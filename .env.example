# Server
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000

# AI (server only - never expose GEMINI_API_KEY to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_PROMPT_LENGTH=4000
RATE_LIMIT_MAX_REQUESTS=30

# Firebase Admin
FIREBASE_PROJECT_ID=

# Firestore: memory fallback is for local development/tests only.
FIRESTORE_ALLOW_MEMORY_FALLBACK=false

# Supabase (server)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase (Vite/browser - public client values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments (server only)
PAYMENT_MODE=mock
STRIPE_WEBHOOK_SECRET=
PIX_WEBHOOK_SECRET=

# In production, CORS_ORIGINS, FIREBASE_PROJECT_ID, Supabase credentials,
# and real payment webhook secrets are required. Mock payment mode is rejected.
