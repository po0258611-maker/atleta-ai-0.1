# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGINS=

# AI & Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Firebase / Firestore
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIRESTORE_ALLOW_MEMORY_FALLBACK=true
FIRESTORE_DISABLE_MEMORY_FALLBACK=false

# Supabase (Optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments & Subscriptions (Mercado Pago, Stripe, PIX)
PAYMENT_MODE=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ENV=sandbox
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
PIX_WEBHOOK_SECRET=

# Security & Rate Limiting
RATE_LIMIT_MAX_REQUESTS=300
MAX_PROMPT_LENGTH=4000
TRUST_PROXY=false
