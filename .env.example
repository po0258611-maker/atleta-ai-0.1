# Server
NODE_ENV=development
PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
MAX_PROMPT_LENGTH=4000
RATE_LIMIT_MAX_REQUESTS=30

# Firebase Admin
FIREBASE_PROJECT_ID=

# Supabase (server)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase (Vite/browser - public client values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments: mock is for development/tests only.
# Production must use live gateway adapters implemented and verified server-side.
PAYMENT_MODE=mock
