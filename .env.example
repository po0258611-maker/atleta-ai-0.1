# Server
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000

# AI (server only - never expose GEMINI_API_KEY to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_PROMPT_LENGTH=4000
RATE_LIMIT_MAX_REQUESTS=30

# Firebase Admin
FIREBASE_PROJECT_ID=

# Firestore: memory fallback is for local development/tests only.
FIRESTORE_ALLOW_MEMORY_FALLBACK=false

# Supabase (server)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase (Vite/browser - public client values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments (server only) — disabled until the dedicated gateway phase
PAYMENTS_ENABLED=false
PAYMENT_MODE=disabled
STRIPE_WEBHOOK_SECRET=
PIX_WEBHOOK_SECRET=

# In production, payment endpoints remain disabled unless a real gateway is explicitly
# configured with PAYMENTS_ENABLED=true, PAYMENT_MODE=live and the required secrets.
