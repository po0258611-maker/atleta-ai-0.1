rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Client may maintain only presentation metadata at the user root.
      // Identity, roles, billing and privileged fields are server-authoritative.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt']);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;

      match /profile/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /workouts/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /sessions/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /exerciseLogs/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /progression/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Subscription state is server-authoritative. Clients may read it,
      // but cannot grant, extend, cancel, or otherwise modify billing state.
      match /subscription/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /measurements/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
